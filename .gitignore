# Publish only the extension, user guide, selected screenshot, and portable regression tests.
/*
!/.gitignore
!/README.md
!/package.json
!/TabBuster/
!/tests/
/tests/*
!/tests/check-extension.cjs
!/assets/
/assets/*
!/assets/screenshots/
/assets/screenshots/*
!/assets/screenshots/TabBusterPopUp.jpg

# Keep generated files and local configuration out of source control.
node_modules/
.env
.env.*
*.log
.DS_Store
Thumbs.db
